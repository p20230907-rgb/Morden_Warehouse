{
  "type": "object",
  "properties": {
    "shelf_id": {
      "type": "string",
      "pattern": "^[A-G]$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "qty"
        ]
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 3
    },
    "avoid_obstacles": {
      "type": "boolean",
      "default": true
    },
    "max_retries": {
      "type": "integer",
      "minimum": 1,
      "default": 3
    }
  },
  "required": [
    "shelf_id",
    "items"
  ]
}